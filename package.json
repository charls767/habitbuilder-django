{
  "name": "habitbuilder-mobile-mock",
  "version": "0.1.0",
  "private": true,
  "description": "Prism mock server tooling for the HabitBuilder mobile client, backed by docs/openapi.yaml.",
  "scripts": {
    "mock:api": "prism mock docs/openapi.yaml -p 4010 --host 127.0.0.1",
    "mock:smoke": "node scripts/mock-smoke.mjs",
    "test:coverage-script": "node --test scripts/check-changed-coverage.test.mjs",
    "coverage:changed": "node scripts/check-changed-coverage.mjs"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.10.0"
  }
}
