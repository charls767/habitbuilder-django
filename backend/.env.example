# Copiar a .env y completar. NUNCA commitear .env (esta en .gitignore).

DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
JWT_SIGNING_KEY=cambiar-por-otra-clave-distinta-a-la-anterior
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL en Neon (mismo esquema de conexion que .env.deploy del backend Go)
DATABASE_URL=postgres://usuario:password@ep-xxxx.neon.tech/habitbuilder
DB_SSLMODE=require

# JWT (paridad con la duracion de tokens del backend Go)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
